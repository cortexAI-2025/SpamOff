<manifest xmlns:android="http://schemas.android.com/apk/res/android">
 <uses-permission android:name="android.permission.INTERNET" />
 <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
 <application android:name=".SpamOffApp" android:label="SpamOff" android:icon="@drawable/ic_shield" android:roundIcon="@drawable/ic_shield" android:theme="@style/Theme.SpamOff" android:allowBackup="false" android:supportsRtl="true" android:usesCleartextTraffic="false">
  <activity android:name=".MainActivity" android:exported="true">
   <intent-filter><action android:name="android.intent.action.MAIN"/><category android:name="android.intent.category.LAUNCHER"/></intent-filter>
  </activity>
  <service android:name=".screening.SpamScreeningService" android:exported="true" android:permission="android.permission.BIND_SCREENING_SERVICE">
   <intent-filter><action android:name="android.telecom.CallScreeningService"/></intent-filter>
  </service>
 </application>
</manifest>
